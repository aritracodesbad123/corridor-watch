  "cards": [
    {
      "dot": "rose",
      "title": "Roles",
      "items": [
        "Analyst can monitor, and cannot hold, escalate, or freeze",
        "FIU lead confirms high-risk actions",
        "MRM auditor investigates and reads the audit, and does not record a disposition"
      ]
    },
    {
      "dot": "cyan",
      "title": "Gemini tools",
      "items": [
        "get_account_context, get_shared_devices, get_session_biometrics, get_network_neighborhood",
