        "note": "Analyst, FIU lead, and MRM auditor share the console. Only the FIU lead can confirm a high-risk hold."
      },
      {
        "id": "tool-calls",
        "label": "Gemini tool calls",
        "focus": ["dag", "gemini", "account", "devices", "sessions", "network"],
        "note": "After the DAG, Gemini may call four evidence tools. The calls are written to the audit log."
      },
      {
        "id": "ledger",
        "label": "Case store",
        "focus": ["api", "sql", "network"],
        "note": "Alerts, cached verdicts, and tool results stay in Cloud SQL."
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "origin": [36, 40],
    "cols": 4,
    "gapX": 48,
